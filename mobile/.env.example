# Example environment configuration for Super Score mobile.
#
# This project currently reads its API configuration from
# src/config/api.ts rather than from this file directly (see that file
# for details and the reasoning). This .env.example documents the shape
# a future react-native-config (or similar) based setup would use, and
# doubles as a quick reference for local backend URLs.

# Base URL of the backend API (no trailing slash).
API_BASE_URL=http://localhost:8000

# NOTE: Android emulators cannot reach your host machine via
# "localhost" — the emulator treats that as itself, not your computer.
# Use http://10.0.2.2:8000 instead when running against a local backend
# from the Android emulator. iOS simulators can use localhost directly.
# Physical devices need your machine's LAN IP (e.g. http://192.168.x.x:8000).

# Which named environment this build should behave as.
# One of: development | staging | production
APP_ENV=development
